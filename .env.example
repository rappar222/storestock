# StoreStock Production Environment Configuration
PORT=3000

# ==========================================
# SMTP Email Settings (for feedback delivery)
# ==========================================

# Option A: Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM=your_email@gmail.com
SMTP_TLS=true

