{
  "manifest_version": 3,
  "name": "StoreStock Companion",
  "version": "1.0.0",
  "description": "Unlocks 100% direct client-side store inventory search for StoreStock on your laptop.",
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://*.altex.ro/*",
    "https://*.emag.ro/*",
    "https://*.pcgarage.ro/*",
    "https://*.flanco.ro/*",
    "https://*.evomag.ro/*",
    "https://*.auchan.ro/*",
    "https://*.amazon.de/*",
    "https://*.amazon.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "storestock_cors_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://storestock.polychroms.dev/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "companion@storestock.polychroms.dev",
      "strict_min_version": "109.0"
    }
  }
}
